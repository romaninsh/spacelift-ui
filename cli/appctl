#!/usr/bin/env python3
"""appctl — what exists, what is running where, and what may be promoted.

Every subcommand prints JSON to stdout, which is what lets Vantage treat this
as a table source. Nothing here holds state: what each environment should run
is a Spacelift stack variable, and what it actually runs is read back from
Cloud Run.

Depends only on the standard library plus the CLIs it fronts: yq, gcloud, gh
and spacectl.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HEALTH_TIMEOUT = 10


class Failure(Exception):
    """Anything the user should see as a plain message rather than a traceback."""


def ensure_path():
    """GUI callers (Vantage actions) inherit the launchd PATH, which has no
    Homebrew on it — so yq, gcloud and gh all vanish. Put them back."""
    current = os.environ.get("PATH", "").split(os.pathsep)
    missing = [
        d for d in ("/opt/homebrew/bin", "/usr/local/bin")
        if d not in current and os.path.isdir(d)
    ]
    if missing:
        os.environ["PATH"] = os.pathsep.join(missing + current)


def run(args, check=True, cwd=None):
    result = subprocess.run(args, capture_output=True, text=True, cwd=cwd)
    if check and result.returncode != 0:
        raise Failure(f"{args[0]} failed: {result.stderr.strip() or result.stdout.strip()}")
    return result


def repo_root():
    """APPCTL_REPO when set — how Vantage points at it — else walk up."""
    if "APPCTL_REPO" in os.environ:
        root = Path(os.environ["APPCTL_REPO"])
        if not (root / "apps.yaml").is_file():
            raise Failure(f"APPCTL_REPO={root} has no apps.yaml")
        return root

    for candidate in [Path.cwd(), *Path.cwd().parents]:
        if (candidate / "apps.yaml").is_file():
            return candidate
    raise Failure("no apps.yaml in any parent directory; set APPCTL_REPO")


def read_yaml(path):
    return json.loads(run(["yq", "-o=json", ".", str(path)]).stdout)


def inventory(root):
    return read_yaml(root / "apps.yaml")


# --- Spacelift ---------------------------------------------------------------

DEPLOY_VARIABLE = "TF_VAR_deploy"
# The name of the tag a stack is pinned to. The commit alone would do, but only
# this makes "uat runs base-0.1.0" answerable without a git checkout.
BASE_VARIABLE = "BASE_VERSION"


def load_credentials(root):
    """spacectl reads SPACELIFT_API_KEY_*; fall back to the untracked env file
    so the dashboard can run this without secrets in its own config."""
    if os.environ.get("SPACELIFT_API_KEY_ID"):
        return
    path = root / ".secret" / "spacelift.env"
    if not path.is_file():
        raise Failure(f"no Spacelift credentials: set SPACELIFT_API_KEY_* or add {path}")
    for line in path.read_text().splitlines():
        line = line.strip().removeprefix("export ")
        if line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        os.environ.setdefault(key.strip(), value.strip().strip("\"'"))


def graphql(query):
    body = json.loads(run(["spacectl", "api", query]).stdout)
    if body.get("errors"):
        raise Failure("; ".join(e.get("message", "?") for e in body["errors"]))
    return body["data"]


def stack_id(app, env):
    """One stack per service per environment, so production changes can never
    ride along with a lower environment's run."""
    return f"{app}-{env}"


def stack_states(app, envs):
    """The two things an environment runs, plus whether it managed to. The
    artifact is a stack variable and the terraform is the commit the stack is
    pinned to; neither lives in the repository. One query per environment."""
    def read(env):
        stack = graphql(
            '{ stack(id:"%s") { state trackedCommit { hash } config { id value } } }'
            % stack_id(app, env)
        )["stack"]
        if stack is None:
            return env, None
        config = {item["id"]: item["value"] for item in stack["config"]}
        document = config.get(DEPLOY_VARIABLE)
        return env, {
            "deploy": json.loads(document) if document else None,
            "sha": (stack["trackedCommit"] or {}).get("hash"),
            "base": config.get(BASE_VARIABLE),
            "state": stack["state"],
        }

    with ThreadPoolExecutor(max_workers=8) as pool:
        return {env: found for env, found in pool.map(read, envs) if found}


def deployments(app, envs):
    states = stack_states(app, envs)
    return {env: state["deploy"] for env, state in states.items() if state["deploy"]}


def setvar(stack, name, value):
    run(["spacectl", "stack", "environment", "setvar", "--id", stack, name, value])


def apply(app, env, document, pin=None):
    """Write what this environment should run, then run it. A pin carries the
    terraform; without one only the artifact moves."""
    stack = stack_id(app, env)
    if pin and pin["sha"]:
        run(["spacectl", "stack", "set-current-commit", "--id", stack, "--sha", pin["sha"]])
        if pin["base"]:
            setvar(stack, BASE_VARIABLE, pin["base"])
    setvar(stack, DEPLOY_VARIABLE, json.dumps(document, sort_keys=True))
    run(["spacectl", "stack", "deploy", "--id", stack])


STACK_OUTPUTS = """{ stacks { id outputs { id value sensitive description } } }"""


def stack_children(query, collection, only_stack):
    """Every stack's `collection` in one round trip. Spacelift exposes none of
    these as a root query — they only exist inside a stack — so the whole set
    comes back at once and the caller narrows it."""
    for stack in graphql(query)["stacks"]:
        if only_stack and stack["id"] != only_stack:
            continue
        for item in stack[collection] or []:
            yield stack["id"], item


def decode_output(value):
    """Outputs arrive JSON-encoded (a URL comes over as `"\\"https://…\\""`).
    Hand back the string a human would read; anything structured stays JSON."""
    if value is None:
        return None
    try:
        decoded = json.loads(value)
    except json.JSONDecodeError:
        return value
    return decoded if isinstance(decoded, str) else json.dumps(decoded, separators=(",", ":"))


def find(items, key, what):
    for item in items:
        if item["key"] == key:
            return item
    raise Failure(f"no {what} '{key}' in apps.yaml")


def services(inv):
    return [c for c in inv["components"] if c["kind"] == "service"]


def version_key(version):
    """Sort key for api-1.2.3 style versions; unparseable sorts lowest."""
    tail = version.rsplit("-", 1)[-1] if version else ""
    try:
        return tuple(int(part) for part in tail.split("."))
    except ValueError:
        return (-1,)


# --- Cloud Run ---------------------------------------------------------------


def describe(inv, app, env):
    """What Cloud Run says is running. None when the service does not exist."""
    spec = find(inv["components"], app, "component")
    name = spec["service"].replace("{env}", env)
    result = run(
        [
            "gcloud", "run", "services", "describe", name,
            f"--region={inv['region']}", f"--project={inv['project']}",
            "--format=json",
        ],
        check=False,
    )
    if result.returncode != 0:
        return None

    served = json.loads(result.stdout)
    conditions = served.get("status", {}).get("conditions", [])
    ready = any(c.get("type") == "Ready" and c.get("status") == "True" for c in conditions)
    containers = (
        served.get("spec", {}).get("template", {}).get("spec", {}).get("containers", [])
    )
    image = containers[0].get("image", "") if containers else ""

    return {
        "url": served.get("status", {}).get("url"),
        "ready": ready,
        "image": image,
        "digest": image.split("@", 1)[1] if "@" in image else None,
        "revision": served.get("status", {}).get("latestReadyRevisionName"),
    }


def probe(url, path):
    """Fetch the component's health path. Returns (ok, parsed body or None)."""
    if not url or not path:
        return False, None
    try:
        with urllib.request.urlopen(url.rstrip("/") + path, timeout=HEALTH_TIMEOUT) as reply:
            body = reply.read().decode("utf-8", "replace")
            if not 200 <= reply.status < 300:
                return False, None
            try:
                return True, json.loads(body)
            except json.JSONDecodeError:
                return True, None
    except (urllib.error.URLError, TimeoutError, OSError):
        return False, None


# --- rows --------------------------------------------------------------------


def deployment_rows(root, inv, only_app=None, only_env=None):
    wanted = [c for c in services(inv) if only_app in (None, c["key"])]
    envs = [e for e in inv["environments"] if only_env in (None, e["key"])]
    env_keys = [e["key"] for e in inv["environments"]]
    states = {c["key"]: stack_states(c["key"], env_keys) for c in wanted}

    def build(pair):
        spec, env = pair
        app, key = spec["key"], env["key"]
        state = states[app].get(key) or {}
        want = state.get("deploy") or {}
        live = describe(inv, app, key)
        healthy, body = (False, None)
        if live and live["ready"]:
            healthy, body = probe(live["url"], spec.get("health"))

        if not want:
            status = "absent"
        elif not live:
            status = "not deployed"
        elif live["digest"] != want.get("digest"):
            status = "deploying"
        elif healthy:
            status = "healthy"
        else:
            status = "unhealthy"

        return {
            "id": f"{app}/{key}",
            # Grids sort on one column, so promotion order has to be encoded
            # rather than expressed as (app, order).
            "sort_key": f"{app}/{env['order']:02d}",
            "app": app,
            "env": key,
            "order": env["order"],
            "version": want.get("version"),
            "digest": want.get("digest"),
            "base": state.get("base"),
            "sha": state.get("sha"),
            "stack_state": state.get("state"),
            "running_digest": live["digest"] if live else None,
            "running_version": (body or {}).get("version"),
            "color": (body or {}).get("color"),
            "url": live["url"] if live else None,
            "revision": live["revision"] if live else None,
            "ready": bool(live and live["ready"]),
            "healthy": healthy,
            "status": status,
            "next_env": env.get("promotes_to"),
        }

    pairs = [(spec, env) for spec in wanted for env in envs]
    with ThreadPoolExecutor(max_workers=8) as pool:
        rows = list(pool.map(build, pairs))

    # Freshness is relative to the newest version this app has anywhere, and
    # promotability is decided here so callers never re-derive the rule.
    by_app = {}
    for row in rows:
        by_app.setdefault(row["app"], []).append(row)

    for mine in by_app.values():
        newest = max((version_key(r["version"]) for r in mine if r["version"]), default=None)
        by_env = {r["env"]: r for r in mine}
        for row in mine:
            row["drift"] = (
                "absent" if not row["version"]
                else "current" if version_key(row["version"]) == newest
                else "behind"
            )
            target = by_env.get(row["next_env"])
            # Healthy proves the artifact runs; FINISHED proves the terraform
            # under it applied, which a health probe cannot see when only the
            # pin moved.
            row["promotable"] = (
                row["status"] == "healthy"
                and row["stack_state"] == "FINISHED"
                and target is not None
                and (target["digest"], target["base"]) != (row["digest"], row["base"])
            )

    rows.sort(key=lambda r: (r["app"], r["order"]))
    return rows


# --- commands ----------------------------------------------------------------


def cmd_apps(args, root, inv):
    # Columns the table doesn't declare are ignored, so pass the component
    # through and only flatten the one field that isn't a scalar.
    return [
        {
            **c,
            "image": c.get("image"),
            "features": ", ".join(f["variable"] for f in c.get("features") or []),
        }
        for c in inv["components"]
    ]


def cmd_envs(args, root, inv):
    return inv["environments"]


def cmd_deployments(args, root, inv):
    return deployment_rows(root, inv, args.app, args.env)


def cmd_outputs(args, root, inv):
    rows = []
    for stack, item in stack_children(STACK_OUTPUTS, "outputs", args.stack):
        rows.append({
            # Output names are unique within a stack, not across them.
            "id": f"{stack}/{item['id']}",
            "stack": stack,
            "name": item["id"],
            "value": decode_output(item["value"]),
            "sensitive": item["sensitive"],
            "description": item["description"],
        })
    return rows


def cmd_prs(args, root, inv):
    result = run(
        [
            "gh", "pr", "list", "--state=open", "--limit=100",
            "--json=number,title,isDraft,reviewDecision,author,url,files,updatedAt",
        ],
        cwd=str(root),
    )
    rows = []
    for pr in json.loads(result.stdout):
        paths = [f["path"] for f in pr.get("files") or []]
        touched = sorted({
            c["key"] for c in inv["components"]
            if any(p.startswith(c["path"] + "/") for p in paths)
        })
        if args.app and args.app not in touched:
            continue
        rows.append({
            "number": pr["number"],
            "title": pr["title"],
            "state": "draft" if pr["isDraft"] else "review",
            "review": pr.get("reviewDecision") or "PENDING",
            "author": (pr.get("author") or {}).get("login"),
            "apps": ", ".join(touched),
            "url": pr["url"],
            "updated_at": pr["updatedAt"],
        })
    return rows


def cmd_promote(args, root, inv):
    source = find(inv["environments"], args.source, "environment")
    find(inv["environments"], args.target, "environment")

    # One rung at a time: the ladder is the point.
    if source.get("promotes_to") != args.target:
        raise Failure(
            f"{args.source} promotes to {source.get('promotes_to')}, not {args.target}"
        )

    rows = deployment_rows(root, inv, only_app=args.app)
    from_row = next(r for r in rows if r["env"] == args.source)
    to_row = next(r for r in rows if r["env"] == args.target)

    if not from_row["version"]:
        raise Failure(f"{args.app} has nothing deployed in {args.source}")

    if from_row["stack_state"] != "FINISHED" and not args.force:
        raise Failure(
            f"{args.app} in {args.source} last ran '{from_row['stack_state']}', not FINISHED — "
            f"refusing to promote terraform that did not apply. Use --force to override."
        )

    if from_row["status"] != "healthy" and not args.force:
        raise Failure(
            f"{args.app} in {args.source} is '{from_row['status']}', not healthy — "
            f"refusing to promote it. Use --force to override."
        )

    if (to_row["digest"], to_row["base"]) == (from_row["digest"], from_row["base"]):
        return {
            "promoted": False,
            "reason": f"{args.target} already runs {from_row['version']} on {from_row['base']}",
        }

    # The pair moves together, so the target can only ever run a combination of
    # terraform and artifact the source actually ran. The target keeps its own
    # feature flags, which are environment configuration rather than part of
    # what was built.
    current = deployments(args.app, [args.target])
    document = {
        **current.get(args.target, {}),
        "version": from_row["version"],
        "digest": from_row["digest"],
    }
    pin = {"sha": from_row["sha"], "base": from_row["base"]}

    result = {
        "promoted": not args.dry_run,
        "app": args.app,
        "from": args.source,
        "to": args.target,
        "version": from_row["version"],
        "digest": from_row["digest"],
        "base": from_row["base"],
        "replaced": to_row["version"],
        "replaced_base": to_row["base"],
        "stack": stack_id(args.app, args.target),
    }
    if args.dry_run:
        result["document"] = document
        return result

    apply(args.app, args.target, document, pin)
    return result


def cmd_features(args, root, inv):
    rows = []
    for spec in services(inv):
        if args.app not in (None, spec["key"]):
            continue
        pinned = deployments(spec["key"], [e["key"] for e in inv["environments"]])
        for env in inv["environments"]:
            if args.env not in (None, env["key"]):
                continue
            overrides = (pinned.get(env["key"]) or {}).get("features") or {}
            for feature in spec.get("features") or []:
                override = overrides.get(feature["variable"])
                rows.append({
                    "id": f"{spec['key']}/{env['key']}/{feature['key']}",
                    "app": spec["key"],
                    "env": env["key"],
                    "order": env["order"],
                    "key": feature["key"],
                    "title": feature["title"],
                    "variable": feature["variable"],
                    "value": override if override is not None else feature["default"],
                    "source": "override" if override is not None else "default",
                    "deployed": env["key"] in pinned,
                })
    rows.sort(key=lambda r: (r["app"], r["order"], r["key"]))
    return rows


def cmd_feature_set(args, root, inv):
    spec = find(inv["components"], args.app, "component")
    feature = find(spec.get("features") or [], args.key, f"feature on {args.app}")
    find(inv["environments"], args.env, "environment")

    pinned = deployments(args.app, [args.env])
    if args.env not in pinned:
        raise Failure(
            f"{args.app} has nothing deployed in {args.env} — "
            f"setting a flag there would describe a service that does not exist"
        )

    document = {**pinned[args.env]}
    features = {**(document.get("features") or {})}
    if args.clear:
        features.pop(feature["variable"], None)
    else:
        features[feature["variable"]] = args.value
    document["features"] = features

    result = {
        "app": args.app,
        "env": args.env,
        "key": args.key,
        "variable": feature["variable"],
        "value": None if args.clear else args.value,
        "effective": features.get(feature["variable"], feature["default"]),
        "applied": not args.dry_run,
    }
    if not args.dry_run:
        apply(args.app, args.env, document)
    return result


def main():
    parser = argparse.ArgumentParser(prog="appctl", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="group", required=True)

    for group, handler, flags in [
        ("apps", cmd_apps, []),
        ("envs", cmd_envs, []),
        ("deployments", cmd_deployments, ["--app", "--env"]),
        ("prs", cmd_prs, ["--app"]),
        ("outputs", cmd_outputs, ["--stack"]),
        ("features", cmd_features, ["--app", "--env"]),
    ]:
        listing = (
            sub.add_parser(group)
            .add_subparsers(dest="action", required=True)
            .add_parser("list")
        )
        for flag in flags:
            listing.add_argument(flag)
        listing.set_defaults(handler=handler)

    promote = sub.add_parser("promote", help="copy a digest to the next environment")
    promote.add_argument("--app", required=True)
    promote.add_argument("--from", dest="source", required=True)
    promote.add_argument("--to", dest="target", required=True)
    promote.add_argument("--dry-run", action="store_true")
    promote.add_argument("--force", action="store_true", help="promote an unhealthy source")
    promote.set_defaults(handler=cmd_promote)

    feature = sub.add_parser("feature", help="set or clear a feature flag").add_subparsers(
        dest="action", required=True
    ).add_parser("set")
    feature.add_argument("--app", required=True)
    feature.add_argument("--env", required=True)
    feature.add_argument("--key", required=True)
    feature.add_argument("--value")
    feature.add_argument("--clear", action="store_true", help="revert to the declared default")
    feature.add_argument("--dry-run", action="store_true")
    feature.set_defaults(handler=cmd_feature_set)

    args = parser.parse_args()
    ensure_path()
    try:
        root = repo_root()
        load_credentials(root)
        print(json.dumps(args.handler(args, root, inventory(root)), indent=2))
    except Failure as failure:
        print(str(failure), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
